# =======================================================================
# RippleRisk — Root .gitignore
# =======================================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Configs
.idea/
*.iml
.vscode/
*.ipr
*.iws
.project
.classpath
.settings/

# Build & Dependency Artifacts (Frontend)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local
frontend/.env.*.local

# Build & Dependency Artifacts (Backend)
backend/target/
backend/*.jar
backend/*.war
backend/*.nar
backend/*.class

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.system_generated/
